# Drop 'N Roll — frontend environment template
#
# Copy to `.env` and fill in. `.env` is gitignored; this file is committed, so it must
# never contain a real credential.
#
# ── How Vite env vars work (read this before adding one) ──────────────────────
# 1. ONLY names prefixed `VITE_` are exposed to client code. Anything else is dropped.
# 2. They are INLINED AT BUILD TIME, not read at runtime. `npm run build` bakes the
#    current values into dist/. Changing .env after a build changes nothing until you
#    rebuild — and the CI deploy job must therefore supply the production values as
#    build-time env (see .github/workflows/ci.yml), not as server config.
# 3. Everything here ships to the browser and is trivially readable by any visitor.
#    NOTHING SECRET GOES IN THIS FILE. Server-side keys (Stripe secret, Ideal Postcodes,
#    Turnstile secret) belong in the backend .env only.

# ── Backend origin ─────────────────────────────────────────────────────────────
# Local dev: http://127.0.0.1:8000
# Production: https://dropnroll.co.uk  (SPA and API are SAME-ORIGIN — nginx serves the
# static build and proxies /api/, /ws/, /admin/ to daphne. There is no api. subdomain.)
# WebSocket URLs are derived from this (src/utils/wsUrl.js): https -> wss, http -> ws.
VITE_NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000

# ── Google OAuth2 (public client id) ───────────────────────────────────────────
# Must match the backend's CLIENT_ID and have this origin in its Authorized JS origins.
VITE_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ── Google Maps (browser key) ──────────────────────────────────────────────────
# Public by design, so restrict it in the Google Cloud console by HTTP referrer to
# your domains — that referrer restriction is the only thing protecting your quota.
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-browser-key

# ── Stripe (publishable key) ───────────────────────────────────────────────────
# pk_test_... for dev, pk_live_... for production. Pairs with STRIPE_SECRET_KEY on the
# backend — a pk/sk mismatch between test and live fails at payment confirmation.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key

# ── Cloudflare Turnstile (public site key) ─────────────────────────────────────
# The bot-check widget is hidden entirely when this is unset.
# `1x00000000000000000000AA` is Cloudflare's ALWAYS-PASSES test key — fine for dev, but
# in production it means every bot passes. Replace it with the real site key AND set
# TURNSTILE_SECRET_KEY on the backend; the widget alone verifies nothing if the backend
# has no secret to validate the token against.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# ── Feature flags ──────────────────────────────────────────────────────────────
# Postcode-first address lookup via Ideal Postcodes (proxied through the backend so the
# API key is never exposed). Defaults to true when unset; set exactly "false" to fall
# back to the Google Places flow.
# VITE_USE_IDEAL_POSTCODES_PRIMARY=true
